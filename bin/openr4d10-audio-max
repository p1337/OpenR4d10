#!/usr/bin/env bash
set -Eeuo pipefail

for _attempt in {1..10}; do
    if /usr/bin/amixer -q -c whisplaysound cset name=speaker 100; then
        echo "OpenR4d10 Whisplay speaker gain set to calibrated maximum: 100"
        exit 0
    fi
    /usr/bin/sleep 1
done

echo "Whisplay ALSA speaker control was not available after 10 seconds" >&2
exit 1
