[Unit]
Description=Maintain the OpenR4d10 NetworkManager fallback hotspot
Documentation=https://github.com/p1337/OpenR4d10
Requires=NetworkManager.service
After=NetworkManager.service

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/local/sbin/openr4d10-hotspot
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/etc/NetworkManager/system-connections /var/lib/openr4d10 /run/openr4d10 /run/lock
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
MemoryDenyWriteExecute=true

