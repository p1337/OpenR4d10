[Unit]
Description=OpenR4d10 receiver UI
Documentation=https://github.com/p1337/OpenR4d10
After=local-fs.target
Wants=network-online.target
After=network-online.target
After=openr4d10-boot.service
Wants=openr4d10-update-recover.service
After=openr4d10-update-recover.service

[Service]
Type=simple
User=openr4d10
Group=openr4d10
SupplementaryGroups=gpio spi audio i2c
ExecStart=/usr/local/bin/openr4d10 --config /etc/openr4d10/openr4d10.toml --hardware-config /etc/openr4d10/hardware.toml run
Restart=on-failure
RestartSec=3s
RuntimeDirectory=openr4d10 openr4d10-boot
RuntimeDirectoryMode=0770
RuntimeDirectoryPreserve=yes
WorkingDirectory=/run/openr4d10
StateDirectory=openr4d10
StateDirectoryMode=0750
UMask=0027

# The renderer receives its SPI/GPIO devices; media receives generic ALSA only.
# I2C, PiSugar and unrelated devices remain blocked.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=false
DevicePolicy=closed
DeviceAllow=/dev/spidev0.0 rw
DeviceAllow=/dev/gpiochip0 rw
DeviceAllow=/dev/i2c-1 rw
DeviceAllow=char-alsa rw
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
MemoryDenyWriteExecute=true
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
RestrictNamespaces=true
ReadWritePaths=/run/openr4d10 /var/lib/openr4d10 -/run/openr4d10-boot

[Install]
WantedBy=multi-user.target
